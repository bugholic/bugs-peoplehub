generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DayPart {
  FULL
  FIRST_HALF
  SECOND_HALF
}

enum WorkMode {
  OFFICE
  REMOTE
  // Day-level only: the day's sessions were a mix of office and remote.
  HYBRID
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
  HOLIDAY
  WEEKEND
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(EMPLOYEE)
  createdAt    DateTime  @default(now())
  employee     Employee?
}

model Department {
  id        String     @id @default(cuid())
  name      String     @unique
  employees Employee[]
}

model Designation {
  id        String     @id @default(cuid())
  name      String     @unique
  employees Employee[]
}

model Location {
  id           String              @id @default(cuid())
  name         String              @unique
  // Office geofence: a check-in within radiusMeters of this point counts as office.
  // null coordinates = not an office (e.g. "Remote").
  latitude     Float?
  longitude    Float?
  radiusMeters Int                 @default(200)
  employees    Employee[]
  holidays     Holiday[]
  sessions     AttendanceSession[]
}

model Employee {
  id                 String         @id @default(cuid())
  empCode            String         @unique
  firstName          String
  lastName           String
  email              String         @unique
  phone              String?
  photoUrl           String?
  joinDate           DateTime       @db.Date
  status             EmployeeStatus @default(ACTIVE)
  userId             String?        @unique
  user               User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  departmentId       String?
  department         Department?    @relation(fields: [departmentId], references: [id])
  designationId      String?
  designation        Designation?   @relation(fields: [designationId], references: [id])
  locationId         String?
  location           Location?      @relation(fields: [locationId], references: [id])
  reportingManagerId String?
  reportingManager   Employee?      @relation("Reporting", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  reportees          Employee[]     @relation("Reporting")

  leaveBalances   LeaveBalance[]
  leaveRequests   LeaveRequest[]          @relation("Applicant")
  leaveApprovals  LeaveRequest[]          @relation("Approver")
  attendance      AttendanceLog[]
  regularizations RegularizationRequest[] @relation("RegApplicant")
  regApprovals    RegularizationRequest[] @relation("RegApprover")
  remoteRequests  RemoteWorkRequest[]     @relation("RemoteApplicant")
  remoteApprovals RemoteWorkRequest[]     @relation("RemoteApprover")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
}

model LeaveType {
  id           String         @id @default(cuid())
  name         String         @unique
  code         String         @unique
  annualQuota  Decimal        @db.Decimal(5, 1)
  paid         Boolean        @default(true)
  carryForward Boolean        @default(false)
  allowHalfDay Boolean        @default(true)
  active       Boolean        @default(true)
  balances     LeaveBalance[]
  requests     LeaveRequest[]
}

model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  year        Int
  granted     Decimal   @db.Decimal(5, 1)
  used        Decimal   @default(0) @db.Decimal(5, 1)

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id           String        @id @default(cuid())
  employeeId   String
  employee     Employee      @relation("Applicant", fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId  String
  leaveType    LeaveType     @relation(fields: [leaveTypeId], references: [id])
  fromDate     DateTime      @db.Date
  toDate       DateTime      @db.Date
  dayPart      DayPart       @default(FULL)
  days         Decimal       @db.Decimal(5, 1)
  reason       String
  status       RequestStatus @default(PENDING)
  approverId   String?
  approver     Employee?     @relation("Approver", fields: [approverId], references: [id], onDelete: SetNull)
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime      @default(now())

  @@index([employeeId, fromDate])
  @@index([status])
}

model Holiday {
  id         String    @id @default(cuid())
  date       DateTime  @db.Date
  name       String
  // null = applies to all locations
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([date])
}

model AttendanceLog {
  id            String              @id @default(cuid())
  employeeId    String
  employee      Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date          DateTime            @db.Date
  // First check-in and last check-out of the day; checkOut is null while a session is open.
  checkIn       DateTime?
  checkOut      DateTime?
  // total of the day's closed sessions
  workedMinutes Int                 @default(0)
  status        AttendanceStatus    @default(PRESENT)
  regularized   Boolean             @default(false)
  // Summary of the sessions' modes; null for logs created before geofencing, or by regularization
  workMode      WorkMode?
  sessions      AttendanceSession[]
  remoteRequest RemoteWorkRequest?

  @@unique([employeeId, date])
}

/**
 * One check-in to check-out stretch; a day can have several (e.g. stepping out and back in).
 */
model AttendanceSession {
  id                String        @id @default(cuid())
  attendanceLogId   String
  attendanceLog     AttendanceLog @relation(fields: [attendanceLogId], references: [id], onDelete: Cascade)
  checkIn           DateTime
  // null while the session is open
  checkOut          DateTime?
  // OFFICE or REMOTE, decided at check-in; null for sessions backfilled from older logs
  workMode          WorkMode?
  officeLocationId  String?
  officeLocation    Location?     @relation(fields: [officeLocationId], references: [id], onDelete: SetNull)
  checkInLatitude   Float?
  checkInLongitude  Float?
  checkInAccuracy   Float?
  checkOutLatitude  Float?
  checkOutLongitude Float?
  checkOutAccuracy  Float?

  @@index([attendanceLogId])
}

model RegularizationRequest {
  id           String        @id @default(cuid())
  employeeId   String
  employee     Employee      @relation("RegApplicant", fields: [employeeId], references: [id], onDelete: Cascade)
  date         DateTime      @db.Date
  checkIn      DateTime
  checkOut     DateTime
  reason       String
  status       RequestStatus @default(PENDING)
  approverId   String?
  approver     Employee?     @relation("RegApprover", fields: [approverId], references: [id], onDelete: SetNull)
  decisionNote String?
  decidedAt    DateTime?
  createdAt    DateTime      @default(now())

  @@index([status])
}

/**
 * Raised when an employee checks out of a remote day; decided by HR (admins).
 */
model RemoteWorkRequest {
  id              String        @id @default(cuid())
  employeeId      String
  employee        Employee      @relation("RemoteApplicant", fields: [employeeId], references: [id], onDelete: Cascade)
  attendanceLogId String        @unique
  attendanceLog   AttendanceLog @relation(fields: [attendanceLogId], references: [id], onDelete: Cascade)
  date            DateTime      @db.Date
  // First remote check-in and latest remote check-out of the day
  checkIn         DateTime
  checkOut        DateTime
  // Total of the day's remote sessions
  remoteMinutes   Int           @default(0)
  status          RequestStatus @default(PENDING)
  approverId      String?
  approver        Employee?     @relation("RemoteApprover", fields: [approverId], references: [id], onDelete: SetNull)
  decisionNote    String?
  decidedAt       DateTime?
  createdAt       DateTime      @default(now())

  @@index([status])
}
